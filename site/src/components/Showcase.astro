---
import Mark from './Mark.astro';
import Rise from './Rise.astro';

const tabs = [
  { key: 'context', title: 'Context', caption: 'The agent starts every step with exactly what it needs.' },
  { key: 'ideas', title: 'Ideas', caption: 'Brainstorm inside what you’ve already chosen.' },
  { key: 'taste', title: 'Taste', caption: 'Write down why once. See it in every change.' },
];
const context = [
  ['Prices are only calculated on the server', 'api/pricing.ts'],
  ['Discounts apply before tax', 'you, 3 weeks ago'],
  ['Checkout keeps its step order', 'checkout/flow.ts'],
  ['Client-side totals were tried and dropped', 'git history'],
];
---
<section class="section stage-orange showcase" id="see">
  <div class="dots" aria-hidden="true"></div>
  <div class="wrap">
    <div class="head">
      <p class="label" data-scramble data-reveal>In practice</p>
      <Rise lines={['Feels like the tools', 'you already use.']} />
    </div>

    <div class="show" data-show data-active="0">
      <div class="pills" role="tablist" aria-label="Examples">
        {tabs.map((t, i) => (
          <button type="button" role="tab" class="pill" aria-selected={i === 0 ? 'true' : 'false'} data-go={i}>
            {t.title}<span class="bar" aria-hidden="true"><span></span></span>
          </button>
        ))}
      </div>

      <div class="tilt" data-tilt>
        <div class="window">
          <div class="chrome">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="title mono" data-title>checkout · agent</span>
            <span class="kr mono"><Mark /> kraddle</span>
          </div>

          <!-- 1 · agent panel -->
          <div class="panel agent on" data-panel="0">
            <div class="msg me"><p>Add a discount code field to checkout</p></div>
            <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="ctx" data-seq>
              <button type="button" class="ctx-head" aria-expanded="true" data-toggle>
                <span class="kmark"><Mark /></span>
                <span><b>Context from Kraddle</b><span class="muted"> · 4 things this step needs</span></span>
                <span class="chev" aria-hidden="true">⌄</span>
              </button>
              <ul class="ctx-list">
                {context.map(([what, from], i) => <li style={`--i:${i}`}><span class="tick" aria-hidden="true"></span><span>{what}</span><span class="from mono">{from}</span></li>)}
              </ul>
              <p class="skipped mono">1,314 other facts skipped. Not needed for this step.</p>
            </div>
            <div class="tool t1" data-seq><span class="ico" aria-hidden="true">✎</span><span class="mono">ui/Checkout.tsx</span><span class="add mono">+18</span><span class="del mono">−2</span></div>
            <div class="tool t2" data-seq><span class="ico" aria-hidden="true">✎</span><span class="mono">api/pricing.ts</span><span class="add mono">+11</span><span class="del mono">−0</span></div>
            <div class="msg bot" data-seq><p>Done. Two files changed, nothing else touched.</p>
              <div class="held"><span class="chip mono">held · step order</span><span class="chip mono">held · server-side prices</span></div>
            </div>
            <div class="composer" aria-hidden="true"><span>Ask the agent…</span><span class="send">↑</span></div>
          </div>

          <!-- 2 · ideation chat -->
          <div class="panel ideas" data-panel="1" data-ideation>
            <div class="row me"><span class="avatar you mono">you</span><div class="bubble"><p>What if people could pay in crypto at checkout?</p></div></div>
            <div class="row"><span class="avatar k"><Mark /></span><div class="bubble k">
              <p>Payments are Stripe-only right now, chosen in March to keep refunds simple. Crypto would need a second refund flow and payouts in two currencies.</p>
              <div class="choices">
                <button type="button" class="choice" data-choice="explore">Explore it anyway</button>
                <button type="button" class="choice" data-choice="park">Park it for later</button>
              </div>
            </div></div>
            <div class="row reply" data-reply="explore" hidden><span class="avatar k"><Mark /></span><div class="bubble k"><p>Okay. Refunds, payouts and receipt emails would change. I’ll draft a plan that keeps Stripe as the default.</p></div></div>
            <div class="row reply" data-reply="park" hidden><span class="avatar k"><Mark /></span><div class="bubble k"><p><span class="chip mono">held</span> Parked. I’ll bring it back the next time payments come up.</p></div></div>
            <div class="composer" aria-hidden="true"><span>Try an idea…</span><span class="send">↑</span></div>
          </div>

          <!-- 3 · editor with a heuristic -->
          <div class="panel taste" data-panel="2" data-taste>
            <div class="ed">
              <div class="ftab mono">heuristics/components.md</div>
              <pre class="code mono" data-h><span class="ln">1</span><span class="hl"># One component, many looks</span>
<span class="ln">2</span>
<span class="ln">3</span>Prefer one component with a
<span class="ln">4</span>variant over near-copies of it.
<span class="ln">5</span>
<span class="ln">6</span><span class="hl">Why:</span> copies drift, and drift
<span class="ln">7</span>is where bugs live.</pre>
            </div>
            <div class="ed">
              <div class="ftab mono">src/ui/price.tsx <span class="applied">applied · one component, many looks</span></div>
              <pre class="code mono"><span class="ln">1</span><span class="d">export function PriceTag()   {'{'} … {'}'}</span>
<span class="ln">2</span><span class="d">export function PriceLabel() {'{'} … {'}'}</span>
<span class="ln">3</span><span class="d">export function PriceBadge() {'{'} … {'}'}</span>
<span class="ln">4</span><span class="a">export function Price({'{'} variant {'}'}) {'{'} … {'}'}</span></pre>
            </div>
          </div>
        </div>
      </div>

      <div class="caps">
        {tabs.map((t, i) => <p class={`cap${i === 0 ? ' on' : ''}`} data-cap={i}>{t.caption}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .showcase { position: relative; overflow: hidden; --k-graphite: #3A1A0C; }
  .showcase .head :global(h2) { color: #121212; }
  .showcase .label { color: #3A1A0C; }
  .dots { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(18,18,18,.16) 1.3px, transparent 1.7px); background-size: 22px 22px; mask-image: radial-gradient(ellipse at 50% 60%, #000 20%, transparent 75%); pointer-events: none; }
  .show { position: relative; max-width: 1000px; margin-inline: auto; display: flex; flex-direction: column; align-items: center; gap: 28px; }

  .pills { display: inline-flex; padding: 5px; gap: 4px; background: rgba(18,18,18,.1); }
  .pill { all: unset; cursor: pointer; position: relative; padding: 10px 22px; font-family: var(--k-font-mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: #121212; overflow: hidden; transition: background .3s, color .3s; }
  .pill[aria-selected="true"] { background: #121212; color: #EEEEEA; }
  .pill:focus-visible { outline: 2px solid #121212; outline-offset: 2px; }
  .pill .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; }
  .pill .bar span { display: block; height: 100%; background: #FF5A1F; transform: scaleX(0); transform-origin: 0 50%; }
  .pill[aria-selected="true"] .bar span { animation: fill var(--dur, 7s) linear forwards; }
  .show.paused .pill[aria-selected="true"] .bar span { animation-play-state: paused; }
  @keyframes fill { to { transform: scaleX(1); } }

  .tilt { width: 100%; perspective: 1400px; }
  .window {
    --wbg: #F8F8F6; --wfg: #121212; --wmuted: #6B6B66; --wline: #E2E2DC; --wsoft: #EEEEEA;
    background: var(--wbg); color: var(--wfg); border: 1px solid rgba(18,18,18,.25);
    box-shadow: 0 50px 90px -40px rgba(18,18,18,.55), 0 2px 0 rgba(18,18,18,.08);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .5s var(--ease);
    height: clamp(520px, 56vw, 600px); display: flex; flex-direction: column; overflow: hidden; position: relative;
  }
  .chrome { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-bottom: 1px solid var(--wline); background: var(--wsoft); flex: none; }
  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #D4D4CE; }
  .title { font-size: 12px; color: var(--wmuted); flex: 1; text-align: center; }
  .kr { font-size: 11px; color: var(--wmuted); display: inline-flex; gap: 6px; align-items: center; letter-spacing: .06em; }
  .kr :global(.mark), .kmark :global(.mark), .avatar.k :global(.mark) { width: 12px; height: auto; overflow: visible; }

  .panel { position: absolute; inset: 45px 0 0; padding: 22px clamp(16px, 4vw, 40px) 84px; display: flex; flex-direction: column; gap: 14px; overflow: hidden; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .45s var(--ease), transform .6s var(--ease), visibility 0s .45s; }
  .panel.on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .composer { position: absolute; left: clamp(16px, 4vw, 40px); right: clamp(16px, 4vw, 40px); bottom: 18px; display: flex; justify-content: space-between; align-items: center; padding: 12px 12px 12px 16px; border: 1px solid var(--wline); background: #fff; color: var(--wmuted); font-size: 15px; }
  .send { width: 30px; height: 30px; display: grid; place-items: center; background: #121212; color: #EEEEEA; font-size: 15px; }

  /* agent panel */
  .msg { max-width: 82%; }
  .msg p { font-size: 16.5px; line-height: 1.45; }
  .msg.me { align-self: flex-end; background: #121212; color: #EEEEEA; padding: 11px 15px; }
  .typing { display: flex; gap: 5px; padding: 6px 2px; }
  .typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--wmuted); animation: bob 1s var(--ease) infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes bob { 50% { transform: translateY(-4px); opacity: .4; } }
  .ctx { border: 1px solid var(--wline); background: #fff; }
  .ctx-head { all: unset; box-sizing: border-box; cursor: pointer; width: 100%; display: flex; align-items: center; gap: 10px; padding: 11px 14px; font-size: 15px; }
  .ctx-head:focus-visible { outline: 2px solid #FF5A1F; }
  .kmark { width: 22px; height: 22px; display: grid; place-items: center; background: #121212; color: #EEEEEA; flex: none; }
  .muted { color: var(--wmuted); }
  .chev { margin-left: auto; transition: transform .35s var(--ease); }
  .ctx-head[aria-expanded="false"] .chev { transform: rotate(-90deg); }
  .ctx-list { list-style: none; margin: 0; padding: 0 14px 4px; display: grid; gap: 0; overflow: hidden; transition: max-height .45s var(--ease), padding .3s; max-height: 260px; }
  .ctx-head[aria-expanded="false"] + .ctx-list { max-height: 0; padding-bottom: 0; }
  .ctx-list li { display: grid; grid-template-columns: 14px 1fr auto; gap: 10px; align-items: center; padding: 7px 0; border-top: 1px solid var(--wline); font-size: 14.5px; }
  .tick { width: 8px; height: 8px; background: #3C9A5F; }
  .from { font-size: 11px; color: var(--wmuted); white-space: nowrap; }
  .skipped { font-size: 11px; color: var(--wmuted); padding: 8px 14px 11px; border-top: 1px dashed var(--wline); }
  .tool { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1px solid var(--wline); background: #fff; font-size: 13px; }
  .ico { color: var(--wmuted); }
  .add { color: #2F7D4C; margin-left: auto; font-size: 12px; }
  .del { color: #B8410F; font-size: 12px; }
  .msg.bot p { font-size: 16.5px; }
  .held { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .chip { font-size: 11px; padding: 3px 8px; background: #DCEADF; color: #2F7D4C; }
  /* sequence: hidden until the panel plays */
  .agent [data-seq], .agent .typing { opacity: 0; transform: translateY(8px); transition: opacity .45s var(--ease), transform .55s var(--ease); }
  .agent.play .typing { animation: typingShow 1.1s var(--ease) forwards; }
  @keyframes typingShow { 0% { opacity: 0; transform: none; } 15%, 85% { opacity: 1; transform: none; } 100% { opacity: 0; height: 0; padding: 0; } }
  .agent.play [data-seq] { opacity: 1; transform: none; }
  .agent.play .ctx { transition-delay: 1.1s; }
  .agent.play .tool.t1 { transition-delay: 1.8s; }
  .agent.play .tool.t2 { transition-delay: 2.3s; }
  .agent.play .msg.bot { transition-delay: 2.9s; }
  .agent .ctx-list li { opacity: 0; transform: translateX(8px); transition: opacity .4s, transform .5s var(--ease); }
  .agent.play .ctx-list li { opacity: 1; transform: none; transition-delay: calc(1.3s + var(--i) * .12s); }

  /* ideation chat */
  .row { display: flex; gap: 12px; align-items: flex-start; }
  .row.me { flex-direction: row-reverse; }
  .avatar { width: 32px; height: 32px; flex: none; display: grid; place-items: center; font-size: 10px; text-transform: uppercase; }
  .avatar.you { background: #D4D4CE; color: #121212; border-radius: 50%; }
  .avatar.k { background: #121212; color: #EEEEEA; }
  .bubble { max-width: 76%; padding: 12px 15px; background: #121212; color: #EEEEEA; }
  .bubble.k { background: #fff; color: #121212; border: 1px solid var(--wline); border-left: 3px solid #FF5A1F; }
  .bubble p { font-size: 16px; line-height: 1.45; }
  .choices { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .choice { font: inherit; font-family: var(--k-font-mono); font-size: 12.5px; padding: 8px 12px; border: 1px solid #121212; background: transparent; color: #121212; cursor: pointer; transition: background .2s, color .2s, transform .3s var(--ease); }
  .choice:hover { background: #121212; color: #EEEEEA; transform: translateY(-2px); }
  .choice[aria-pressed="true"] { background: #FF5A1F; border-color: #FF5A1F; }
  .reply:not([hidden]) { animation: rise .5s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }

  /* editor */
  .taste { flex-direction: row; gap: 0; padding: 0; }
  .ed { flex: 1; min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--wline); }
  .ed:last-child { border-right: 0; }
  .ftab { font-size: 12px; padding: 10px 16px; border-bottom: 1px solid var(--wline); color: var(--wmuted); display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .applied { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; padding: 3px 7px; background: #DCEADF; color: #2F7D4C; transition: background .3s, color .3s; }
  .code { margin: 0; padding: 16px; font-size: 13.5px; line-height: 1.9; white-space: pre-wrap; flex: 1; transition: background .3s; }
  .ln { display: inline-block; width: 2.2ch; color: #B5B5AE; user-select: none; }
  .hl { color: #C4420E; }
  .d { color: #9A9A94; text-decoration: line-through; }
  .a { color: #2F7D4C; font-weight: 700; background: #DCEADF; }
  .taste:hover [data-h], .taste.lit [data-h] { background: #FFE3D8; }
  .taste:hover .applied, .taste.lit .applied { background: #FF5A1F; color: #121212; }
  @media (max-width: 720px) { .taste { flex-direction: column; } .ed { border-right: 0; border-bottom: 1px solid var(--wline); } .from { display: none; } }

  .caps { position: relative; width: 100%; min-height: 36px; text-align: center; }
  .cap { position: absolute; inset: 0; font-size: clamp(18px, 1.8vw, 22px); color: #121212; opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .5s var(--ease); }
  .cap.on { opacity: 1; transform: none; }
</style>
