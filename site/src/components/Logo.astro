---
import Mark from './Mark.astro';

interface Props { href?: string; size?: number; class?: string }
const { href = '/', size = 22, class: cls = '' } = Astro.props;
---
<a class={`logo ${cls}`} href={href} style={`--size:${size}px`} aria-label="Kraddle home">
  <Mark motion="turnable" />
  <span>kraddle</span>
</a>

<style>
  .logo {
    display: inline-flex; align-items: center; gap: .32em;
    font-family: var(--k-font-mono); font-weight: 800; letter-spacing: -.06em;
    font-size: var(--size); line-height: 1; color: var(--k-ink); text-decoration: none;
  }
  .logo :global(.mark) { height: .82em; width: auto; overflow: visible; }
  .logo:hover :global(.turnable), .logo:focus-visible :global(.turnable) { transform: rotate(180deg); }
</style>
