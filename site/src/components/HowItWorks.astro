---
import Rise from './Rise.astro';

const cases = [
  {
    title: 'Bring your codebase',
    steps: ['Bring the code you already have.', 'See what it does, what’s been decided, and what’s still a guess.', 'Make the next change with those choices in view.'],
    titleCard: 'Start with what exists.',
    preview: ['Observed: projects list has filters', 'Your decision: recently updated first', 'Open question: what happens with no results?'],
  },
  {
    title: 'Start from an idea',
    steps: ['Describe what’s in your head.', 'Work through the choices that shape it.', 'Give agents a direction you can inspect and revise.'],
    titleCard: 'Make the idea concrete.',
    preview: ['Intent: help me finish my side projects', 'Choice: one place for active work', 'Still open: what belongs on the first screen?'],
  },
  {
    title: 'Come back after a break',
    steps: ['Return after a few weeks.', 'Find the decisions, their reasons, and unfinished questions.', 'Pick up the thread without rebuilding the whole context.'],
    titleCard: 'Your past self left a trail.',
    preview: ['Chosen: active projects come first', 'Why: less hunting, more finishing', 'Parked: shared projects with friends'],
  },
  {
    title: 'Try a wild idea',
    steps: ['Suggest a new direction.', 'See which choices and parts it would affect.', 'Explore an alternative without losing the reason for the original.'],
    titleCard: 'Change your mind on purpose.',
    preview: ['What if: group projects by client?', 'Touches: navigation and saved filters', 'Keep: the current approach and its reasons'],
  },
];
---
<section class="section how" id="how">
  <div class="wrap">
    <div class="head">
      <p class="label" data-scramble data-reveal>The workflow we’re building</p>
      <Rise lines={['Start anywhere.', 'It keeps up.']} />
    </div>

  </div>
  <div class="workflow-track" data-workflow>
    <div class="workflow-pin">
      <div class="wrap workflow-frame">
      <div class="workflow-top"><p class="mono">Four ways in. One connected project.</p><p class="mono scroll-cue">Scroll to explore <span aria-hidden="true">↓</span></p></div>
      <div class="list" role="tablist" aria-label="Use cases">
        {cases.map((c, i) => (
          <button type="button" role="tab" id={`case-tab-${i}`} tabindex={i === 0 ? '0' : '-1'} class="case" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`case-panel-${i}`} data-go={i}>
            <span class="n readout">{String(i + 1).padStart(2, '0')}</span><span class="t">{c.title}</span><span class="case-line" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="stage">
        {cases.map((c, i) => (
          <div class={`shot${i === 0 ? ' on' : ''}`} data-shot={i} id={`case-panel-${i}`} role="tabpanel" aria-labelledby={`case-tab-${i}`}>
            <div class="case-copy"><p class="mono case-count">{String(i + 1).padStart(2, '0')} / 04</p><h3>{c.title}</h3><ol class="steps">{c.steps.map((s) => <li><span class="tick" aria-hidden="true"></span>{s}</li>)}</ol></div>
            <div class="snapshot"><span class="mono snapshot-label">Product concept · {c.title}</span><h3>{c.titleCard}</h3><ul>{c.preview.map((line) => <li>{line}</li>)}</ul><p class="mono">Connected to your project. Carried into the next task.</p></div>
          </div>
        ))}
      </div>
      <div class="workflow-bottom mono"><span data-workflow-count>01 / 04</span><span>Keep scrolling. There’s more than one way to begin.</span><span aria-hidden="true">↓</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .how { padding-bottom: 0; }
  .workflow-track { --pin-height: calc(100svh - var(--header-height) - env(safe-area-inset-top, 0px)); --step-distance: max(360px, 70svh); }
  .workflow-pin { background: var(--k-paper); }
  .workflow-track.is-pinned { height: calc(var(--pin-height) + 4 * var(--step-distance)); }
  .is-pinned .workflow-pin { position: sticky; top: calc(var(--header-height) + env(safe-area-inset-top, 0px)); height: var(--pin-height); display: flex; align-items: center; }
  .workflow-frame { width: 100%; padding-block: clamp(20px, 4vh, 40px); }
  .workflow-top, .workflow-bottom { display: flex; justify-content: space-between; gap: 16px; font-size: 10px; color: var(--k-graphite); }
  .workflow-top { margin-bottom: 22px; }
  .scroll-cue { white-space: nowrap; }
  .scroll-cue span { display: inline-block; margin-left: 10px; }
  .list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 3vw, 36px); }
  .case { all: unset; box-sizing: border-box; cursor: pointer; position: relative; display: flex; flex-direction: column; gap: 10px; padding-bottom: 18px; color: var(--k-graphite); }
  .case:focus-visible { outline: 2px solid var(--k-orange); outline-offset: 2px; }
  .n { font-size: 25px; transition: color .5s var(--ease); }
  .t { font-size: clamp(12px, 1.3vw, 16px); transition: color .5s var(--ease); }
  .case:hover, .case[aria-selected="true"] { color: var(--k-ink); }
  .case[aria-selected="true"] .n { color: var(--k-orange-text); }
  .case-line { position: absolute; inset: auto 0 0; height: 2px; background: var(--k-line); }
  .case-line::after { content: ''; position: absolute; inset: 0; background: var(--k-orange); transform: scaleX(0); transform-origin: left; transition: transform .65s var(--ease); }
  .case[aria-selected="true"] .case-line::after, .case.passed .case-line::after { transform: scaleX(1); }
  .stage { margin-top: clamp(24px, 4vh, 40px); }
  .shot { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding-bottom: 48px; }
  .is-pinned .stage { display: grid; }
  .is-pinned .shot { grid-area: 1 / 1; padding-bottom: 0; opacity: 0; visibility: hidden; transform: translateY(14px); pointer-events: none; transition: opacity .65s var(--ease), transform .65s var(--ease); }
  .is-pinned .shot.on { opacity: 1; visibility: visible; transform: none; pointer-events: auto; }
  .case-count { color: var(--k-orange-text); font-size: 11px; margin-bottom: 16px; }
  .case-copy h3 { font-size: clamp(32px, 4vw, 52px); max-width: 14ch; }
  .steps { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 16px; }
  .steps li { display: flex; gap: 12px; align-items: baseline; font-size: clamp(16px, 1.5vw, 20px); }
  .tick { width: 8px; height: 8px; flex: none; background: var(--k-green); }
  .snapshot { border: 1px solid var(--k-line); border-radius: 14px; background: var(--k-surface); padding: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; gap: 24px; box-shadow: 0 24px 56px -38px rgba(0,0,0,.45); }
  .snapshot-label { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: var(--k-graphite); }
  .snapshot h3 { font-size: clamp(28px, 3vw, 44px); }
  .snapshot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .snapshot li { border-left: 2px solid var(--k-orange); padding-left: 12px; font-size: clamp(15px, 1.4vw, 18px); }
  .snapshot > p { font-size: 10px; color: var(--k-graphite); }
  .workflow-bottom { margin-top: 28px; border-top: 1px solid var(--k-line); padding-top: 14px; }
  .workflow-bottom > span:first-child { color: var(--k-orange-text); }
  @media (max-width: 600px) and (min-height: 601px) {
    .workflow-frame { padding-block: 20px; }
    .workflow-top { margin-bottom: 16px; }
    .workflow-top > p:first-child { max-width: 22ch; }
    .list { gap: 12px; }
    .case { gap: 7px; padding-bottom: 12px; }
    .n { font-size: 20px; }
    .t { font-size: 11px; line-height: 1.35; }
    .shot { grid-template-columns: 1fr; gap: 20px; }
    .stage { margin-top: 22px; }
    .case-copy h3 { font-size: 30px; max-width: none; }
    .case-count { display: none; }
    .steps { gap: 8px; margin-top: 14px; }
    .steps li { font-size: 14px; gap: 10px; }
    .snapshot { padding: 20px; gap: 14px; }
    .snapshot h3 { font-size: 26px; }
    .snapshot ul { gap: 10px; }
    .snapshot li { font-size: 14px; }
    .snapshot-label { font-size: 9px; }
    .workflow-bottom { margin-top: 20px; font-size: 9px; }
    .workflow-bottom > span:nth-child(2) { max-width: 26ch; }
  }
  @media (max-height: 600px) {
    .workflow-frame { padding-block: 12px; }
    .workflow-top { margin-bottom: 12px; }
    .case { flex-direction: row; align-items: center; gap: 8px; padding-bottom: 10px; }
    .n { font-size: 18px; }
    .t { font-size: 11px; line-height: 1.25; }
    .stage { margin-top: 16px; }
    .shot { gap: 24px; }
    .case-count { display: none; }
    .case-copy h3 { font-size: 28px; }
    .steps { margin-top: 12px; gap: 8px; }
    .steps li { font-size: 13px; gap: 8px; }
    .snapshot { padding: 16px; gap: 12px; }
    .snapshot-label { font-size: 8px; }
    .snapshot h3 { font-size: 25px; }
    .snapshot ul { gap: 8px; }
    .snapshot li { font-size: 13px; }
    .snapshot > p { font-size: 8px; }
    .workflow-bottom { margin-top: 14px; padding-top: 8px; font-size: 9px; }
  }
  @media (max-width: 600px) and (max-height: 600px) {
    .shot { grid-template-columns: 1fr; gap: 16px; }
    .workflow-top > p:first-child, .case-count { display: none; }
    .case { flex-direction: column; align-items: flex-start; }
    .case-copy h3 { font-size: 26px; }
    .snapshot { gap: 10px; }
    .snapshot h3 { font-size: 23px; }
  }
  @media (max-height: 420px) { .workflow-bottom { display: none; } .workflow-top { margin-bottom: 8px; } }
  @media (max-width: 600px) and (max-height: 750px) {
    .workflow-frame { padding-block: 8px; }
    .workflow-top, .workflow-bottom { display: none; }
    .case { flex-direction: column; align-items: flex-start; gap: 6px; padding-bottom: 8px; }
    .n { font-size: 18px; }
    .t { font-size: 10px; line-height: 1.3; }
    .stage { margin-top: 12px; }
    .shot { grid-template-columns: 1fr; gap: 14px; }
    .case-copy h3 { font-size: 24px; max-width: none; }
    .case-count { display: none; }
    .steps { margin-top: 10px; gap: 6px; }
    .steps li { font-size: 12px; line-height: 1.4; }
    .snapshot { padding: 12px; gap: 8px; }
    .snapshot h3 { font-size: 23px; }
    .snapshot-label { font-size: 8px; }
    .snapshot ul { gap: 6px; }
    .snapshot li { font-size: 12px; line-height: 1.4; }
    .snapshot > p { font-size: 7px; }
  }
  @media (prefers-reduced-motion: reduce) { .scroll-cue, .workflow-bottom { display: none; } }
</style>
