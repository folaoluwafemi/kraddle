---
import Rise from './Rise.astro';
import AssetSlot from './AssetSlot.astro';

const cases = [
  {
    title: 'Bring your codebase',
    steps: ['Open your repo in Kraddle.', 'It learns how the project is meant to work.', 'Ask for a change. Nothing else breaks.'],
    asset: { kind: 'Recording' as const, desc: 'Opening an existing repo in the Kraddle desktop app. A readout finishes learning the project, then an agent ships a change with a small, clean diff.' },
  },
  {
    title: 'Start from an idea',
    steps: ['Describe what’s in your head.', 'Kraddle asks only the questions that matter.', 'Agents build it, and it stays consistent as it grows.'],
    asset: { kind: 'Recording' as const, desc: 'Typing a one-paragraph idea. Kraddle asks three sharp questions, then the first screens of the product appear.' },
  },
  {
    title: 'Come back after a break',
    steps: ['Open the project weeks later.', 'See what changed and what’s still open.', 'Pick up where you left off, and so do your agents.'],
    asset: { kind: 'Screenshot' as const, desc: 'A “while you were away” view: what changed, what’s parked, what’s next, all in one screen.' },
  },
  {
    title: 'Try a wild idea',
    steps: ['Suggest something new.', 'See what it would change before anything is touched.', 'Explore it, or park it for later.'],
    asset: { kind: 'Screenshot' as const, desc: 'The ideas view: a new direction, the parts of the project it would affect, and Explore / Park buttons.' },
  },
];
---
<section class="section how" id="how">
  <div class="wrap">
    <div class="head">
      <p class="label" data-scramble data-reveal>How you’ll use it</p>
      <Rise lines={['Start anywhere.', 'It keeps up.']} />
    </div>

    <div class="cases" data-cases>
      <div class="list" role="tablist" aria-label="Use cases">
        {cases.map((c, i) => (
          <div role="tab" tabindex="0" class="case" aria-selected={i === 0 ? 'true' : 'false'} data-go={i}>
            <span class="top"><span class="n readout">{String(i + 1).padStart(2, '0')}</span><span class="t">{c.title}</span><span class="plus" aria-hidden="true"></span></span>
            <ol class="steps">
              {c.steps.map((s, k) => <li style={`--k:${k}`}><span class="tick" aria-hidden="true"></span>{s}</li>)}
            </ol>
            <span class="bar" aria-hidden="true"><span></span></span>
          </div>
        ))}
      </div>
      <div class="stage" data-reveal>
        {cases.map((c, i) => (
          <div class={`shot${i === 0 ? ' on' : ''}`} data-shot={i}>
            <AssetSlot kind={c.asset.kind} desc={c.asset.desc} ratio="16 / 11" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cases { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 64px); align-items: start; max-width: 1180px; margin-inline: auto; }
  @media (max-width: 900px) { .cases { grid-template-columns: 1fr; } .stage { order: -1; } }
  .list { display: flex; flex-direction: column; border-top: 1px solid var(--k-line); }
  .case { all: unset; box-sizing: border-box; cursor: pointer; position: relative; display: flex; flex-direction: column; padding: 22px 4px; border-bottom: 1px solid var(--k-line); }
  .case:focus-visible { outline: 2px solid var(--k-orange); outline-offset: 2px; }
  .top { display: flex; align-items: baseline; gap: 16px; }
  .n { font-size: 20px; color: var(--k-graphite); transition: color .3s; }
  .t { font-family: var(--k-font-header); font-size: clamp(24px, 2.6vw, 34px); letter-spacing: -.02em; color: var(--k-graphite); transition: color .3s, transform .5s var(--ease); }
  .case:hover .t { color: var(--k-ink); transform: translateX(4px); }
  .case[aria-selected="true"] .t { color: var(--k-ink); }
  .case[aria-selected="true"] .n { color: var(--k-orange-text); }
  .plus { margin-left: auto; width: 14px; height: 14px; position: relative; flex: none; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform .45s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  .case[aria-selected="true"] .plus::after { transform: rotate(0deg); }
  .steps { list-style: none; margin: 0; padding: 0 0 0 36px; display: grid; gap: 10px; max-height: 0; overflow: hidden; transition: max-height .6s var(--ease), margin .4s; }
  .case[aria-selected="true"] .steps { max-height: 220px; margin-top: 16px; }
  .steps li { display: flex; gap: 12px; align-items: baseline; font-size: 18px; color: var(--k-ink); opacity: 0; transform: translateX(-6px); transition: opacity .4s, transform .5s var(--ease); }
  .case[aria-selected="true"] .steps li { opacity: 1; transform: none; transition-delay: calc(.15s + var(--k) * .12s); }
  .tick { width: 9px; height: 9px; flex: none; border: 1.5px solid var(--k-green); transform: translateY(-1px); transition: background .3s; }
  .case[aria-selected="true"] .tick { background: var(--k-green); transition-delay: calc(.4s + var(--k) * .12s); }
  .bar { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; }
  .bar span { display: block; height: 100%; background: var(--k-orange); transform: scaleX(0); transform-origin: 0 50%; }
  .case[aria-selected="true"] .bar span { animation: fill var(--dur, 8s) linear forwards; }
  .cases.paused .case[aria-selected="true"] .bar span { animation-play-state: paused; }
  @keyframes fill { to { transform: scaleX(1); } }

  .stage { position: sticky; top: 100px; display: grid; }
  .shot { grid-area: 1 / 1; opacity: 0; transform: scale(.98) translateY(10px); transition: opacity .5s var(--ease), transform .7s var(--ease); pointer-events: none; }
  .shot.on { opacity: 1; transform: none; pointer-events: auto; }
  .shot :global(.slot) { box-shadow: 0 40px 80px -50px color-mix(in srgb, var(--k-ink) 60%, transparent); }
</style>
